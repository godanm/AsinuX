{
  "rules": {

    // ── Kazhutha rooms ────────────────────────────────────────────────────────
    "rooms": {
      "$roomId": {
        ".read":  "auth != null && root.child('rooms').child($roomId).child('players').child(auth.uid).exists()",
        ".write": "auth != null && (root.child('rooms').child($roomId).child('players').child(auth.uid).exists() || newData.child('players').child(auth.uid).exists())",
        "players": {
          "$playerId": {
            ".write": "auth != null && auth.uid == $playerId"
          }
        }
      }
    },

    // ── Room code lookup ──────────────────────────────────────────────────────
    "roomCodes": {
      ".read":  "auth != null",
      ".write": "auth != null"
    },

    // ── Player stats & leaderboard ────────────────────────────────────────────
    "stats": {
      ".read": "auth != null",
      ".indexOn": ["totalPoints"],
      "$uid": {
        ".write": "auth != null && (auth.uid == $uid || $uid.matches(/^npc_/))"
      }
    },

    // ── Matchmaking ───────────────────────────────────────────────────────────
    "matchmaking": {
      ".read": "auth != null",
      "queue": {
        "$uid": {
          ".write": "auth != null && auth.uid == $uid",
          "roomId": {
            ".write": "auth != null"
          }
        }
      },
      "creating": {
        ".write": "auth != null"
      }
    },

    // ── Rummy lobby rooms ─────────────────────────────────────────────────────
    "rummy_rooms": {
      ".read":    "auth != null",
      ".indexOn": ["status"],
      "$roomId": {
        ".write": "auth != null && (root.child('rummy_rooms').child($roomId).child('players').child(auth.uid).exists() || newData.child('players').child(auth.uid).exists())",
        "players": {
          "$playerId": {
            ".write": "auth != null && auth.uid == $playerId"
          }
        }
      }
    },

    // ── Rummy game state (shared, no hand data) ───────────────────────────────
    // Write allowed only when it is the player's turn, or when it is a bot's
    // turn and the writer is the room host (who drives all bot actions).
    // Cloud Functions use the Admin SDK and bypass these rules entirely.
    "rummy_games": {
      "$roomId": {
        ".read":  "auth != null && root.child('rummy_rooms').child($roomId).child('players').child(auth.uid).exists()",
        ".write": "auth != null && root.child('rummy_rooms').child($roomId).child('players').child(auth.uid).exists() && (!data.exists() || data.child('currentTurn').val() == auth.uid || (data.child('currentTurn').val().matches(/^bot_/) && root.child('rummy_rooms').child($roomId).child('hostId').val() == auth.uid))"
      }
    },

    // ── Per-player private hands ──────────────────────────────────────────────
    "rummy_hands": {
      "$roomId": {
        "$playerId": {
          ".read":  "auth != null && (auth.uid == $playerId || ($playerId.matches(/^bot_/) && root.child('rummy_rooms').child($roomId).child('hostId').val() == auth.uid))",
          ".write": "auth != null && (auth.uid == $playerId || ($playerId.matches(/^bot_/) && root.child('rummy_rooms').child($roomId).child('hostId').val() == auth.uid))"
        }
      }
    },

    // ── 28 rooms ──────────────────────────────────────────────────────────────
    "game28_rooms": {
      "$roomId": {
        ".read":  "auth != null && root.child('game28_rooms').child($roomId).child('players').child(auth.uid).exists()",
        ".write": "auth != null && (root.child('game28_rooms').child($roomId).child('players').child(auth.uid).exists() || newData.child('players').child(auth.uid).exists())"
      }
    },

    // ── 28 trump secrets (hidden until revealed) ──────────────────────────────
    // Bid winner can read before reveal; everyone can read after trumpRevealed.
    "game28_secrets": {
      "$roomId": {
        ".read":  "auth != null && (root.child('game28_rooms').child($roomId).child('trumpRevealed').val() == true || auth.uid == root.child('game28_rooms').child($roomId).child('bidWinnerId').val())",
        ".write": "auth != null && root.child('game28_rooms').child($roomId).child('players').child(auth.uid).exists()"
      }
    },

    // ── 28 room code lookup ───────────────────────────────────────────────────
    "game28_codes": {
      ".read":  "auth != null",
      ".write": "auth != null"
    },

    // ── Teen Patti rooms ──────────────────────────────────────────────────────
    // Teen Patti stores all game state in this node (no separate games node).
    // Write is allowed when:
    //   • room doesn't exist yet (creation)
    //   • player is joining (newData has their uid)
    //   • player is a member AND (currentTurn is null = pre-game/between rounds,
    //     OR it is their turn, OR it is a bot turn and they are the host)
    "teen_patti_rooms": {
      "$roomId": {
        ".read":  "auth != null && root.child('teen_patti_rooms').child($roomId).child('players').child(auth.uid).exists()",
        ".write": "auth != null && (!data.exists() || newData.child('players').child(auth.uid).exists() || (data.child('players').child(auth.uid).exists() && (data.child('currentTurn').val() == null || data.child('currentTurn').val() == auth.uid || (data.child('currentTurn').val().matches(/^bot_/) && data.child('hostId').val() == auth.uid))))"
      }
    },

    // ── Teen Patti card secrets ────────────────────────────────────────────────
    // Write at $roomId level so startGame/startNextRound can .remove() the whole node.
    // Read stays at $playerId level: own cards only; host can also read bot slots.
    "teen_patti_secrets": {
      "$roomId": {
        ".write": "auth != null && root.child('teen_patti_rooms').child($roomId).child('players').child(auth.uid).exists()",
        "$playerId": {
          ".read": "auth != null && (auth.uid == $playerId || ($playerId.matches(/^bot_/) && root.child('teen_patti_rooms').child($roomId).child('players').child(auth.uid).exists()))"
        }
      }
    },

    // ── Teen Patti room code lookup ───────────────────────────────────────────
    "teen_patti_codes": {
      ".read":  "auth != null",
      ".write": "auth != null"
    },

    // ── Tambola rooms ─────────────────────────────────────────────────────────
    "tambola_rooms": {
      ".read":    "auth != null",
      ".indexOn": ["status"],
      "$roomId": {
        ".write": "auth != null && (root.child('tambola_rooms').child($roomId).child('players').child(auth.uid).exists() || newData.child('players').child(auth.uid).exists())"
      }
    },

    // ── Tambola game state ────────────────────────────────────────────────────
    // Base: any room member may write (needed for prize claims on prizeWinners
    // and phase). calledNumbers and remainingNumbers are restricted to the host
    // so only the host can advance the number draw.
    "tambola_games": {
      "$roomId": {
        ".read":  "auth != null && root.child('tambola_rooms').child($roomId).child('players').child(auth.uid).exists()",
        ".write": "auth != null && root.child('tambola_rooms').child($roomId).child('players').child(auth.uid).exists()",
        "calledNumbers": {
          ".write": "auth != null && root.child('tambola_rooms').child($roomId).child('hostId').val() == auth.uid"
        },
        "remainingNumbers": {
          ".write": "auth != null && root.child('tambola_rooms').child($roomId).child('hostId').val() == auth.uid"
        }
      }
    },

    // ── Tambola tickets — all players in the room can read all tickets ─────────
    "tambola_tickets": {
      "$roomId": {
        ".read":  "auth != null && root.child('tambola_rooms').child($roomId).child('players').child(auth.uid).exists()",
        "$playerId": {
          ".write": "auth != null && root.child('tambola_rooms').child($roomId).child('players').child(auth.uid).exists()"
        }
      }
    },

    // ── Wild Card rooms ───────────────────────────────────────────────────────
    "wildcard_rooms": {
      ".read":    "auth != null",
      ".indexOn": ["status"],
      "$roomId": {
        ".write": "auth != null && (root.child('wildcard_rooms').child($roomId).child('players').child(auth.uid).exists() || newData.child('players').child(auth.uid).exists())"
      }
    },

    // ── Wild Card game state ──────────────────────────────────────────────────
    // Turn-based rule not feasible here: Wild Card tracks turns via
    // currentPlayerIdx (integer) rather than a player UID, so the rules
    // engine cannot cross-reference it. Membership check closes the main
    // attack surface; the service enforces turn order at the application layer.
    "wildcard_games": {
      "$roomId": {
        ".read":  "auth != null && root.child('wildcard_rooms').child($roomId).child('players').child(auth.uid).exists()",
        ".write": "auth != null && root.child('wildcard_rooms').child($roomId).child('players').child(auth.uid).exists()"
      }
    },

    // ── Wild Card private hands ───────────────────────────────────────────────
    "wildcard_hands": {
      "$roomId": {
        "$playerId": {
          ".read":  "auth != null && (auth.uid == $playerId || root.child('wildcard_rooms').child($roomId).child('hostId').val() == auth.uid)",
          ".write": "auth != null && root.child('wildcard_rooms').child($roomId).child('players').child(auth.uid).exists()"
        }
      }
    },

    // ── User feedback ────────────────────────────────────────────────────────
    "feedback": {
      ".write": "auth != null"
    },

    // ── Error logs ────────────────────────────────────────────────────────────
    "error_logs": {
      "$uid": {
        ".read":  "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    // ── Game logs ─────────────────────────────────────────────────────────────
    "gamelogs": {
      "$roomId": {
        ".read":  false,
        ".write": "auth != null",
        "events": {
          // Fix: Allows the cleanup script to filter/sort by timestamp
          ".indexOn": "ts"
        }
      }
    }

  }
}